# Copy file này thành .env rồi sửa giá trị cho máy của bạn.

NODE_ENV=development
PORT=5105

# Origin của frontend được phép gọi API (cách nhau bằng dấu phẩy). Để trống = cho phép tất cả.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Chạy sau reverse proxy (nginx...) thì đặt, VD "loopback" hoặc "1", để lấy đúng IP người dùng.
TRUST_PROXY=

# Swagger UI tại /api-docs (đặt false để tắt)
API_DOCS=true

# SQL Server (khớp service sqlserver trong docker-compose.yml)
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=NexusSystem
DB_USER=sa
DB_PASSWORD=Nexus@12345
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# MongoDB: chat, OTP, lịch sử thông báo
MONGO_URI=mongodb://localhost:27017
MONGO_DB=NexusChat

# JWT
JWT_KEY=local-development-only-change-this-key-to-something-long
JWT_ISSUER=nexus-system-api
JWT_EXPIRES_IN_MINUTES=480

# SMTP gửi email (OTP, mã đơn hàng, mã tài khoản).
# Để trống EMAIL_USER / EMAIL_PASSWORD ⇒ email được ghi ra folder logs/emails thay vì gửi thật.
# Gmail: EMAIL_PASSWORD là App Password 16 ký tự, KHÔNG phải mật khẩu Gmail.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM_NAME=Nexus Telecom
EMAIL_FROM_ADDRESS=
EMAIL_TIMEOUT_SECONDS=15
EMAIL_LOG_DIR=logs/emails
