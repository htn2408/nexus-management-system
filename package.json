{
  "name": "nexus-system-api",
  "version": "0.1.0",
  "description": "Nexus Service Marketing System API - Node.js / Express",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --import ./tests/setup.js --test \"tests/**/*.test.js\"",
    "test:e2e": "node --test \"tests/e2e/*.e2e.js\"",
    "test:ui": "pnpm --prefix frontend-react test:ui",
    "db:backup": "node --env-file-if-exists=.env scripts/db-backup.js",
    "db:restore": "node --env-file-if-exists=.env scripts/db-restore.js",
    "demo:up": "docker compose -f docker-compose.demo.yml up -d --build",
    "demo:down": "docker compose -f docker-compose.demo.yml down -v"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "decimal.js": "^10.6.0",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "mssql": "^12.7.13",
    "nodemailer": "^10.2.1",
    "socket.io": "^4.8.4",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.4"
  }
}
